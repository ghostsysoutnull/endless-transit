{
  "permissions": {
    "allow": [
      "Bash(./vinc.sh:*)",
      "Bash(./run.sh:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git rev-parse:*)",
      "Bash(date:*)",
      "Write",
      "Edit"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT\" | grep -qE '\\bgit (commit|push)\\b' && echo '[VINCULUM_PROTOCOL] git commit/push requires explicit user authorization. Confirm before proceeding.' >&2 || true"
          }
        ]
      }
    ]
  }
}
