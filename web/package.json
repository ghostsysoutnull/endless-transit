{
  "name": "endless-transit-web",
  "private": true,
  "version": "0.1.0",
  "description": "Endless Transit — the web game (strict TypeScript, single page).",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "imports": {
    "#engine/*": "./src/engine/*",
    "#content/*": "./src/content/*",
    "#platform/*": "./src/platform/*",
    "#ui/*": "./src/ui/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "node scripts/check.ts",
    "e2e": "playwright test",
    "publish:site": "node scripts/publish.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lit-html": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
